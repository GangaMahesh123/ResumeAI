# Required
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=change-me-to-a-long-random-string

# AI model and budgets (defaults shown)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_ANALYSIS_MAX_TOKENS=8000
CLAUDE_REWRITE_MAX_TOKENS=20000
CLAUDE_TIMEOUT_MS=180000
CLAUDE_MAX_RETRIES=3

# Optimization / layout passes (each pass is one extra AI call)
OPTIMIZATION_MAX_PASSES=2
LAYOUT_MAX_PASSES=2

# Storage (mount a Railway volume here so accounts and confirmations survive redeploys)
DATA_DIR=/app/data

# Optional
PORT=3001
RATE_LIMIT_PER_HOUR=20
CORS_ORIGINS=*
RENDER_TIMEOUT_MS=90000
SOFFICE_PATH=soffice
